net xenable => hal_gpio.PIN37-out

net xstep	=> hal_gpio.PIN21-out 
net xdir	=> hal_gpio.PIN19-out
net y0step	=> hal_gpio.PIN23-out
net y0dir	=> hal_gpio.PIN29-out
net zstep	=> hal_gpio.PIN31-out
net zdir	=> hal_gpio.PIN35-out
net y1step	=> hal_gpio.PIN11-out
net y1dir	=> hal_gpio.PIN16-out
net bstep	=> hal_gpio.PIN13-out 
