loadrt charge_pump

# we need a dir mask and an exclude mask
#

# These correspond to the physical pin on the 40pin header
# for directioin, 1=output, 0=input
# for enable, 0=enable, 1=disable
#pin03: 0x01		//1
#pin05: 0x02		//2
#pin07: 0x04		//4
#pin08: 0x1000		//4096
#pin10: 0x2000		//8192
#pin11: 0x8000		//32768
#pin12: 0x10000		//65536
#pin13: 0x2000000	//33554432
#pin15: 0x100000	//1048576
#pin16: 0x200000	//2097152
#pin18: 0x400000	//4194304
#pin19: 0x100		//256
#pin21: 0x80  		//128
#pin22: 0x800000	//8388608
#pin23: 0x200		//512
#pin24: 0x40  		//64
#pin26: 0x20  		//32
#pin29: 0x08		//8
#pin31: 0x10  		//16
#pin32: 0x400		//1024
#pin33: 0x800		//2048
#pin35: 0x20000		//131072
#pin36: 0x4000		//16384
#pin37: 0x1000000	//16777216
#pin38: 0x40000		//262144
#pin40: 0x80000		//524288

# beware pi gpio 21 and 22 are still reversed, they control raspberry pi
# header pins 15&40 and are backwards almost everywhere in rpi docs
# easy to see and check with 'show pins hal_pi_gpio*' - how on Bookworm?
# alternatively, halcmd can be useful in showing LinuxCNC i/o

