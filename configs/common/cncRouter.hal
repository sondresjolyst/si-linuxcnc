##############################################
#				Limit Inputs
##############################################
#net min-home-x	<= hal_gpio.PIN26-in

net min-home-y1 <= hal_gpio.PIN26-in
net min-home-y	<= hal_gpio.PIN32-in
net min-home-xz	<= hal_gpio.PIN33-in

#net min-home-z	<= hal_gpio.PIN33-in
#net all-limit   <= hal_gpio.PIN24-in
#pin 22 is the eSTOP

##############################################
#				Probe Input
##############################################
# Z tool setter, red+black pair, on breakout board terminal P11. Traced at the
# machine: P11 reaches header pin 24. The switch is normally closed, so PIN24-in
# reads FALSE with the plunger released and TRUE when triggered, which is the
# polarity motion.probe-input wants -- no -not here.
net probe-input motion.probe-input <= hal_gpio.PIN24-in

#net X-home hal_pi_gpio.pin-22-in => axis.0.home-sw-in axis.0.neg-lim-sw-in
#net Y-home hal_pi_gpio.pin-24-in => axis.1.home-sw-in axis.1.neg-lim-sw-in
#net Z-home hal_pi_gpio.pin-26-in => axis.2.home-sw-in axis.2.neg-lim-sw-in

# connect pin 32 to all three max limits
