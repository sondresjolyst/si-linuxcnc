<?xml version='1.0' encoding='UTF-8'?>
<pyvcp>
  <labelframe text="Touch off">
    <font>("Helvetica",10)</font>

    <button>
      <relief>RAISED</relief>
      <bd>3</bd>
      <halpin>"touchoff-x"</halpin>
      <text>"Touch off X"</text>
      <font>("Helvetica",10)</font>
      <pady>2</pady>
    </button>

    <label><text>" "</text><font>("Helvetica",2)</font></label>

    <button>
      <relief>RAISED</relief>
      <bd>3</bd>
      <halpin>"touchoff-y"</halpin>
      <text>"Touch off Y"</text>
      <font>("Helvetica",10)</font>
      <pady>2</pady>
    </button>

    <label><text>" "</text><font>("Helvetica",2)</font></label>

    <button>
      <relief>RAISED</relief>
      <bd>3</bd>
      <halpin>"touchoff-z"</halpin>
      <text>"Touch off Z"</text>
      <font>("Helvetica",10)</font>
      <pady>2</pady>
    </button>

  </labelframe>

  <label><text>" "</text><font>("Helvetica",4)</font></label>

  <labelframe text="Tool setter">
    <font>("Helvetica",10)</font>

    <hbox>
      <label>
        <text>"Probe  "</text>
        <font>("Helvetica",10)</font>
      </label>
      <led>
        <halpin>"probe-led"</halpin>
        <size>18</size>
        <on_color>"green"</on_color>
        <off_color>"red"</off_color>
      </led>
    </hbox>

    <label><text>" "</text><font>("Helvetica",4)</font></label>

    <button>
      <relief>RAISED</relief>
      <bd>3</bd>
      <halpin>"setter-zero"</halpin>
      <text>"Touch new tool"</text>
      <font>("Helvetica",10)</font>
      <pady>2</pady>
    </button>

  </labelframe>
</pyvcp>
