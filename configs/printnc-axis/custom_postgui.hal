# Include your custom_postgui HAL commands here
# This file will not be overwritten when you run stepconf again

# Spindle panel, fed by the hy_vfd signals from ../common/cncRouter.hal.
# hy_vfd reports the speed in rpm and the output current in amps.
net spindle-speed-fb => pyvcp.spindle-rpm
net spindle-current  => pyvcp.spindle-current
net spindle-comm-ok  => pyvcp.vfd-led

# Tool setter panel, setter.xml.
net probe-input => pyvcp.probe-led
net setter-zero    pyvcp.setter-zero    => halui.mdi-command-00
net setter-cal     pyvcp.setter-cal     => halui.mdi-command-04

# The touch off buttons go through setter_confirm.py, which names the axis in
# an OK/Cancel dialog before releasing the command.
loadusr -Wn confirm ./setter_confirm.py

net touchoff-x     pyvcp.touchoff-x     => confirm.x-req
net touchoff-y     pyvcp.touchoff-y     => confirm.y-req
net touchoff-z     pyvcp.touchoff-z     => confirm.z-req

net touchoff-x-go  confirm.x-go         => halui.mdi-command-01
net touchoff-y-go  confirm.y-go         => halui.mdi-command-02
net touchoff-z-go  confirm.z-go         => halui.mdi-command-03

# Progress panel, fed by ../common/progress.py.
source ../common/progress.hal

net prog-percent progress.percent     => pyvcp.prog-percent
net prog-remain  progress.remain-min  => pyvcp.prog-remain
net prog-elapsed progress.elapsed-min => pyvcp.prog-elapsed
